# Copy to deploy/private/.env before running Compose.

# Public TLS listener. Place the organization's certificate at
# deploy/private/certs/fullchain.pem and privkey.pem.
PRIVATE_HTTPS_PORT=8443

# Required. Use a long, unique value; do not retain the application default.
ADMIN_PASSWORD=replace-with-a-long-random-password
OWNAGENT_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
OWNAGENT_INGEST_KEY=replace-with-a-long-random-ingest-key

# Exact browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=https://localhost:8443

# This deployment uses each operator's browser-stored Key. Server provider
# keys stay empty unless the customer explicitly chooses a shared-key policy.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# URL used by release/probe workflows when the caller does not provide one.
PROBE_URL=https://localhost:8443/index.html

MAX_REQUEST_BYTES=10485760
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=50000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Required backup target. Point this at a separately replicated disk, NAS,
# or object-storage mount; do not place it inside the application data volume.
BACKUP_HOST_PATH=./backups

# Local image tag built from the repository's existing Dockerfile.
OWNAGENT_IMAGE_TAG=private-local

# Optional approval notifications.
FEISHU_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
APPROVAL_EMAIL_TO=
EMAIL_NOTIFICATION_ENDPOINT=

# Copy to deploy/private/.env before running Compose.

# Public listener. Put TLS in a trusted ingress/reverse proxy in production.
PRIVATE_HTTP_PORT=8080

# Required. Use a long, unique value; do not retain the application default.
ADMIN_PASSWORD=replace-with-a-long-random-password
OWNAGENT_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
OWNAGENT_INGEST_KEY=replace-with-a-long-random-ingest-key

# Exact browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:8080

# Configure at least one provider key for model-backed responses.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# URL used by release/probe workflows when the caller does not provide one.
PROBE_URL=http://localhost:8080/index.html

# Local image tag built from the repository's existing Dockerfile.
OWNAGENT_IMAGE_TAG=private-local

# Optional approval notifications.
FEISHU_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
APPROVAL_EMAIL_TO=
EMAIL_NOTIFICATION_ENDPOINT=

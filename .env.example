# 前端（GitHub Pages build 时设置）
# VITE_API_BASE=https://your-api.onrender.com

# 服务端（Render / Railway / 本地）
PORT=8787
DATABASE_PATH=./data/builder.db
PROBE_URL=https://cpttbtptp2812.github.io/builder/index.html
CORS_ORIGINS=http://localhost:5173,https://cpttbtptp2812.github.io
ADMIN_PASSWORD=replace-with-a-long-random-password
OWNAGENT_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
OWNAGENT_INGEST_KEY=replace-with-a-long-random-ingest-key
MAX_REQUEST_BYTES=10485760
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=50000

# LLM（可选 — 服务端代理，Key 不暴露给浏览器）

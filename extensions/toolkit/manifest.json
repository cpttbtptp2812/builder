{
  "manifest_version": 3,
  "name": "前端联调工具包",
  "version": "1.1.3",
  "description": "ClipHub 摘录跳回 · Env 切环境 · Wire 看 SSE — 一次安装，三个面板",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": ["http://127.0.0.1:38472/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["env-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["env-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["wire-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["wire-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["clip-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "前端联调工具包",
    "default_popup": "popup.html"
  }
}
